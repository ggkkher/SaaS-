generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company         Company?
  offers          Offer[]
}

model Company {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  logoUrl         String?

  hourlyRate      Float     @default(50)
  profitMargin    Float     @default(20)
  materialCost    Float     @default(0)
  fixedCosts      Float     @default(2000)
  taxRate         Float     @default(0.19)

  stripeCustomerId String?
  subscriptionTier String @default("free")
  stripePriceId    String?
  stripeSubscriptionId String?

  offersCreatedThisMonth Int @default(0)
  monthlyResetDate DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Offer {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientName      String
  clientEmail     String?

  positions       Position[]
  shareTokens     OfferShareToken[]

  subtotalNet     Float
  taxAmount       Float
  totalGross      Float

  status          String    @default("draft")
  signatureUrl    String?
  signaturePdfUrl String?

  // Status Tracking Timestamps
  sentAt          DateTime?
  signedAt        DateTime?
  invoicedAt      DateTime?
  sentBy          String?   // User ID who sent the offer

  // Für Nachträge
  parentOfferId   String?
  parentOffer     Offer?    @relation("OfferAmendments", fields: [parentOfferId], references: [id], onDelete: SetNull)
  amendments      Offer[]   @relation("OfferAmendments")
  amendmentType   String?   // "amendment" oder null für original
  amendmentNumber Int?      // 1. Nachtrag, 2. Nachtrag, etc.

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  validUntil      DateTime
}

model Position {
  id              String    @id @default(cuid())
  offerId         String
  offer           Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)

  name            String
  description     String

  quantity        Float
  unit            String

  unitPrice       Float
  totalNet        Float

  hours           Float?
  hourlyRate      Float?

  order           Int
  createdAt       DateTime  @default(now())
}

model OfferShareToken {
  id              String    @id @default(cuid())
  token           String    @unique              // Zufälliger Token für URL
  offerId         String
  offer           Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)

  clientEmail     String?                        // Optional: Pre-fill in form
  expiresAt       DateTime?                      // Optional: Token verfällt
  accessCount     Int       @default(0)          // Tracking wie oft angesehen
  lastAccessedAt  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([token])
  @@index([offerId])
}

